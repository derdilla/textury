  "query": "\n            SELECT T.expires,\n                   T.project_id,\n                   P.title AS project_title,\n                   P.owner_id,\n                   U.name AS owner_name,\n                   P.created_at,\n                   P.last_modified\n               FROM project_join_tokens T\n               JOIN projects P ON T.project_id = P.id\n               JOIN users U ON P.owner_id = U.id\n               WHERE token = ?",
